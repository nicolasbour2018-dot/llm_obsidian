# La vraie clé est lue depuis le fichier .env du projet d'inférence.
MISTRAL_API_KEY=replace-me
MISTRAL_CHAT_MODEL=mistral-small-latest
# Repli OpenAI : utilisé si Mistral refuse (modèle hors abonnement, quota, panne).
# CHAT_PROVIDER=openai force OpenAI pour le chat (les embeddings restent Mistral).
CHAT_PROVIDER=mistral
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
MISTRAL_EMBED_MODEL=mistral-embed
RAG_TOP_K=6
# Chemin du coffre Obsidian sur le Mac (monté dans le conteneur sous /vault).
OBSIDIAN_VAULT_PATH=/Users/nicolasbour/Developer/Nico_2.0
OBSIDIAN_VAULT_NAME=Nico_2.0
# Dossiers exclus de l'index, relatifs au coffre et séparés par des virgules.
RAG_EXCLUDE_DIRS=0 Second Cerveau/Conversations,Recently Deleted
# Jeton partagé entre l'application et le pont Apple Notes du Mac.
APPLE_NOTES_BRIDGE_TOKEN=change-me
